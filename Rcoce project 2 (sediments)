get_core <- function(
    otu_matrix,
    metadata,
    variable,
    group,
    detection = 0.001,
    prevalence = 0.90) {
    # Seleccionar muestras del grupo
  ids <- metadata$SampleID[
    metadata[[variable]] == group  ]
    x <- otu_matrix[ids, , drop = FALSE]
    # Nº de muestras
  n_samples <- nrow(x)
    # Nº de muestras donde cada ASV alcanza >= detection
  n_detected <- colSums(
    x >= detection)
    # Prevalencia
  prev <- n_detected / n_samples
    # ASVs core
  core_asvs <- names(prev)[
    prev >= prevalence]
    data.frame(
    ASV = names(prev),
    n_samples = n_samples,
    n_detected = n_detected,
    prevalence = prev,
    core = names(prev) %in% core_asvs,
    stringsAsFactors = FALSE)}
