core_sensitivity <- function(
    variable,
    group,
    prevalence_values = c(0.80, 0.90, 1.00),
    detection = 0.001) {
  
  bind_rows(
    lapply(
      prevalence_values,
      function(p) {
        
        res <- get_core(
          otu_matrix = core_mat,
          metadata = core_meta,
          variable = variable,
          group = group,
          detection = detection,
          prevalence = p)
        
        data.frame(
          Variable = variable,
          Group = group,
          Detection = detection,
          Prevalence_threshold = p,
          n_samples = unique(res$n_samples),
          min_samples_required =
            ceiling(p * unique(res$n_samples)),
          n_core = sum(res$core))}))}

