dim(d)
#Cargar Metadata
env<-read.csv("Env.csv")
#De d seleccionar ASV (1) y la Taxa (33:38) esto variara segun numero de muestras
tax<-d[,c(1,33:38)]
#Solo selecciona los ASVs
reads<-d[,c(1:32)]
#Muestra el nombre de las columnas
colnames(reads)
#FORMATO PARA PHYLOSEQ
#Convertimos las tablas de abundancia (ASVs), taxonomía y metadata en data frames individuales.
#Necesario para preparar la estructura que requiere el objeto phyloseq.
asv_mat<- reads     # Matriz de abundancias por muestra
tax_mat<- tax       # Tabla de taxonomía asignada a cada ASV
samples_df <- env   # Tabla de metadatos ambientales por muestra

#DEFINIR FILAS (rownames) PARA CADA TABLA 
# En phyloseq, las filas de la matriz de ASVs deben tener los nombres de los ASVs,
# y la metadata debe tener los IDs de muestra como rownames. Aquí lo preparamos:
asv_mat <- as.data.frame(asv_mat)        
tax_mat <- as.data.frame(tax_mat)     

row.names(asv_mat) <- asv_mat$ASV       # Asigna la columna ASV como nombre de fila
asv_mat <- asv_mat%>% select (-ASV)    # Elimina columna ASV (ya está como rowname)

row.names(tax_mat) <- tax_mat$ASV       # Asigna la columna ASV como nombre de fila
tax_mat <- tax_mat%>% select (-ASV)     # Elimina columna ASV

row.names(samples_df) <- samples_df$ID    # Asigna la columna ASV como nombre de fila
samples_df <- samples_df %>% select (-ID) # Elimina columna ID

#CONVERTIR A MATRICES
# phyloseq requiere que las tablas de abundancia y taxonomía estén en formato matriz.
# Aquí se hace la conversión.
asv_mat <- as.matrix(asv_mat)    # Matriz de abundancia (ASVs como filas, muestras como columnas)
tax_mat <- as.matrix(tax_mat)      # Matriz de taxonomía (ASVs como filas, niveles taxonómicos como columnas)

#CREAR OBJETO PHYLOSEQ
#Se crean los objetos individuales y luego se combinan en un único objeto phyloseq.
ASV = otu_table(asv_mat, taxa_are_rows = TRUE)   # Crea la tabla de abundancia
TAX = tax_table(tax_mat)                         # Crea la tabla de taxonomía
samples = sample_data(samples_df)                # Crea el objeto de metadata ambiental
#Se junta todo en un objeto phyloseq
Sed_16S <- phyloseq(ASV, TAX, samples)
Sed_16S<-Sed_16S %>% subset_taxa(Kingdom !="Archaea")     
Sed_16S<-Sed_16S %>% subset_taxa(Order != "Chloroplast")     
Sed_16S<-Sed_16S %>% subset_taxa(Family !="Mitochondria")     
Sed_16S

# Hill (1)-----
library(tidyr)
library(ggplot2)
library(iNEXT)

# Solo sedimentos
sed_hill <- subset_samples(Sed_16S, Type == "Sediment")

# Eliminar ASVs que queden con abundancia 0 después del subset
sed_hill <- prune_taxa(taxa_sums(sed_hill) > 0, sed_hill)

sed_hill
nsamples(sed_hill)
ntaxa(sed_hill)
sample_sums(sed_hill)

meta_hill <- data.frame(sample_data(sed_hill))

table(meta_hill$Site, meta_hill$Date)

hill_counts <- as(otu_table(sed_hill), "matrix")

if(taxa_are_rows(sed_hill)){hill_counts <- t(hill_counts)}

dim(hill_counts)

# stopifnot() comprueba que abundancias y metadata estén exactamente en el mismo orden
stopifnot(identical(rownames(hill_counts), rownames(meta_hill)))

# Hill q = 0, 1 y 2
D0 <- specnumber(hill_counts)

D1 <- exp(diversity(hill_counts, index = "shannon"))

D2 <- diversity(hill_counts, index = "invsimpson")

hill <- data.frame(ID = rownames(hill_counts),
  D0 = D0, D1 = D1, D2 = D2, meta_hill[, c("Site", "Date")])

head(hill)

# Cobertura: check obligatorio
hill_input <- lapply(seq_len(nrow(hill_counts)),
  function(i) hill_counts[i, hill_counts[i, ] > 0])

names(hill_input) <- rownames(hill_counts)

coverage <- DataInfo(hill_input, datatype = "abundance")

coverage

summary(coverage$SC)
range(coverage$SC)

# Resumen descriptivo
hill_summary <- hill %>% group_by(Date, Site) %>% summarise(n = n(),
    D0_median = median(D0), D0_IQR = IQR(D0),
    D1_median = median(D1), D1_IQR = IQR(D1),
    D2_median = median(D2), D2_IQR = IQR(D2), .groups = "drop")

hill_summary

# Estadística espacial dentro de cada fecha
hill_aug <- hill %>% filter(Date == "August")

hill_mar <- hill %>% filter(Date == "March")

# August
kruskal.test(D0 ~ Site, data = hill_aug)
kruskal.test(D1 ~ Site, data = hill_aug)
kruskal.test(D2 ~ Site, data = hill_aug)

# March
kruskal.test(D0 ~ Site, data = hill_mar)
kruskal.test(D1 ~ Site, data = hill_mar)
kruskal.test(D2 ~ Site, data = hill_mar)

# HILL - KRUSKAL-WALLIS EXACTO----
#
# Debido al bajo y desigual número de réplicas, las comparaciones espaciales
# se evalúan mediante la distribución exacta de Kruskal-Wallis.

# Factores para los analisis de Hill----

hill$Site <- factor(hill$Site, levels = c("Bahia_Buzo","San_Gregorio","Buque_Quemado"))

hill$Date <- factor(hill$Date, levels = c("August", "March"))

hill_aug <- droplevels(hill %>% filter(Date == "August"))

hill_mar <- droplevels(hill %>% filter(Date == "March"))

str(hill_aug$Site)
str(hill_mar$Site)

install.packages("ANSM5")   # solo la primera vez
library(ANSM5)

hill_aug_exact <- hill_aug %>% arrange(Site) %>% droplevels()

hill_mar_exact <- hill_mar %>% arrange(Site) %>% droplevels()

# Check: los grupos deben quedar consecutivos
hill_aug_exact[, c("ID", "Site")]
hill_mar_exact[, c("ID", "Site")]

table(hill_aug_exact$Site)
table(hill_mar_exact$Site)

# August
ANSM5::kruskal.wallis(hill_aug_exact$D0, hill_aug_exact$Site, do.exact = TRUE, do.asymp = TRUE)

ANSM5::kruskal.wallis(hill_aug_exact$D1, hill_aug_exact$Site, do.exact = TRUE, do.asymp = TRUE)

ANSM5::kruskal.wallis(hill_aug_exact$D2, hill_aug_exact$Site, do.exact = TRUE, do.asymp = TRUE)

# March
ANSM5::kruskal.wallis(hill_mar_exact$D0, hill_mar_exact$Site, do.exact = TRUE, do.asymp = TRUE)

ANSM5::kruskal.wallis(hill_mar_exact$D1, hill_mar_exact$Site, do.exact = TRUE, do.asymp = TRUE)

ANSM5::kruskal.wallis(hill_mar_exact$D2, hill_mar_exact$Site, do.exact = TRUE, do.asymp = TRUE)

# Check de empates antes de los post hoc----

sapply(hill_aug_exact[, c("D0", "D1", "D2")], anyDuplicated)

sapply(hill_mar_exact[, c("D0", "D1", "D2")], anyDuplicated)

# POST HOC exactos - August----

pairwise.wilcox.test(hill_aug_exact$D1, hill_aug_exact$Site,
  p.adjust.method = "holm", exact = TRUE)

# POST HOC exactos - March----

pairwise.wilcox.test(hill_mar_exact$D0, hill_mar_exact$Site,
  p.adjust.method = "holm", exact = TRUE)

pairwise.wilcox.test(hill_mar_exact$D1, hill_mar_exact$Site,
  p.adjust.method = "holm", exact = TRUE)

pairwise.wilcox.test(hill_mar_exact$D2, hill_mar_exact$Site,
  p.adjust.method = "holm", exact = TRUE)

