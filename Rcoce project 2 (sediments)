if(taxa_are_rows(sed_beta)){otu_beta <- t(otu_beta)}

meta_beta <- data.frame(sample_data(sed_beta))

# Ordenar metadata exactamente igual que la matriz
meta_beta <- meta_beta[rownames(otu_beta), , drop = FALSE]

meta_beta$Site <- factor(meta_beta$Site, levels = c("Bahia_Buzo","San_Gregorio","Buque_Quemado"))

meta_beta$Date <- factor(meta_beta$Date, levels = c("August", "March"))

# Checks
dim(otu_beta)
table(meta_beta$Site, meta_beta$Date)

stopifnot(identical(rownames(otu_beta),rownames(meta_beta)))

sum(is.na(otu_beta))

# Transformacion Hellinger----

otu_hell <- decostand(otu_beta, method = "hellinger")

# Checks
dim(otu_hell)
sum(is.na(otu_hell))

# Hellinger: la suma de cuadrados de cada perfil debe ser 1
summary(rowSums(otu_hell^2))
# Aplicacion distancia Euclediana
