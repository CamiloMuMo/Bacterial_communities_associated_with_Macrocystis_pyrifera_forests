# 2. Beta diversity: Hellinger-Euclidean distances, NMDS, PERMANOVA, PERMDISP-----------------

otu_beta <- as(otu_table(sed), "matrix")
if (taxa_are_rows(sed)) otu_beta <- t(otu_beta)

meta_beta <- data.frame(sample_data(sed))
meta_beta <- meta_beta[rownames(otu_beta), , drop = FALSE]
stopifnot(identical(rownames(otu_beta), rownames(meta_beta)))

# Hellinger transformation followed by Euclidean distance.
otu_hell <- decostand(otu_beta, method = "hellinger")
dist_beta <- dist(otu_hell, method = "euclidean")

# Global dispersion across the six site-by-date groups.
meta_beta$Group <- interaction(meta_beta$Site, meta_beta$Date, drop = TRUE)
disp_group <- betadisper(dist_beta, meta_beta$Group, type = "median", bias.adjust = TRUE)
set.seed(123)
disp_group_test <- permutest(disp_group, permutations = 9999)
print(disp_group_test)

# Global PERMANOVA and marginal interaction test.
set.seed(123)
permanova_full <- adonis2(
  dist_beta ~ Site * Date,
  data = meta_beta,
  permutations = 9999)

print(permanova_full)

set.seed(123)
permanova_margin <- adonis2(
  dist_beta ~ Site * Date,
  data = meta_beta,
  permutations = 9999,
  by = "margin")

print(permanova_margin)

# Helper for simple effects and pairwise tests.
run_two_group_test <- function(otu_matrix, grouping, permutations = 9999) {
  grouping <- droplevels(factor(grouping))
  d <- dist(otu_matrix, method = "euclidean")

  set.seed(123)
  perm <- adonis2(d ~ grouping, permutations = permutations)

  disp <- betadisper(d, grouping, type = "median", bias.adjust = TRUE)
  set.seed(123)
  disp_test <- permutest(disp, permutations = permutations)

  data.frame(
    R2 = perm$R2[1],
    F = perm$F[1],
    p_raw = perm$`Pr(>F)`[1],
    p_dispersion = disp_test$tab$`Pr(>F)`[1])}

# Spatial simple effects within each sampling period.
spatial_results <- bind_rows(lapply(levels(meta_beta$Date), function(d) {
  idx <- meta_beta$Date == d
  x <- run_two_group_test(otu_hell[idx, , drop = FALSE], meta_beta$Site[idx])
  cbind(Date = d, x)}))

spatial_results$p_Holm <- p.adjust(spatial_results$p_raw, method = "holm")
print(spatial_results)

# Sampling-period simple effects within each site.
temporal_results <- bind_rows(lapply(levels(meta_beta$Site), function(s) {
  idx <- meta_beta$Site == s
  x <- run_two_group_test(otu_hell[idx, , drop = FALSE], meta_beta$Date[idx])
  cbind(Site = s, x)}))

temporal_results$p_Holm <- p.adjust(temporal_results$p_raw, method = "holm")
print(temporal_results)

# Pairwise spatial PERMANOVA within a sampling period.
run_pairwise_sites <- function(date_value) {
  idx_date <- meta_beta$Date == date_value
  x <- otu_hell[idx_date, , drop = FALSE]
  site <- droplevels(meta_beta$Site[idx_date])
  pairs <- combn(levels(site), 2, simplify = FALSE)

  out <- bind_rows(lapply(pairs, function(pair) {
    idx <- site %in% pair
    res <- run_two_group_test(x[idx, , drop = FALSE], site[idx])
    cbind(
      Date = date_value,
      Contrast = paste(pair, collapse = " vs "),
      res)}))

  out$p_Holm <- p.adjust(out$p_raw, method = "holm")
  out}

pairwise_aug <- run_pairwise_sites("August")
pairwise_mar <- run_pairwise_sites("March")
