# 1. Alpha diversity: Hill numbers-----------

hill_counts <- as(otu_table(sed), "matrix")
if (taxa_are_rows(sed)) hill_counts <- t(hill_counts)

meta_hill <- data.frame(sample_data(sed))
meta_hill <- meta_hill[rownames(hill_counts), , drop = FALSE]
stopifnot(identical(rownames(hill_counts), rownames(meta_hill)))

# Hill numbers: q = 0 (richness), q = 1 (exp Shannon), q = 2 (inverse Simpson).
D0 <- specnumber(hill_counts)
D1 <- exp(diversity(hill_counts, index = "shannon"))
D2 <- diversity(hill_counts, index = "invsimpson")

hill <- data.frame(
  ID = rownames(hill_counts),
  D0 = D0,
  D1 = D1,
  D2 = D2,
  Site = meta_hill$Site,
  Date = meta_hill$Date)

# Sampling completeness.
hill_input <- lapply(
  seq_len(nrow(hill_counts)),
  function(i) hill_counts[i, hill_counts[i, ] > 0])

names(hill_input) <- rownames(hill_counts)
coverage <- iNEXT::DataInfo(hill_input, datatype = "abundance")
print(range(coverage$SC))

# Descriptive statistics.
hill_summary <- hill %>%
  group_by(Date, Site) %>%
  summarise(
    n = n(),
    D0_median = median(D0), D0_IQR = IQR(D0),
    D1_median = median(D1), D1_IQR = IQR(D1),
    D2_median = median(D2), D2_IQR = IQR(D2),
    .groups = "drop")
print(hill_summary)

# Exact Kruskal-Wallis tests were used because replication was small and unequal.
hill_aug <- hill %>% filter(Date == "August") %>% arrange(Site) %>% droplevels()
hill_mar <- hill %>% filter(Date == "March") %>% arrange(Site) %>% droplevels()

kw_aug_D0 <- ANSM5::kruskal.wallis(hill_aug$D0, hill_aug$Site, do.exact = TRUE, do.asymp = TRUE)
kw_aug_D1 <- ANSM5::kruskal.wallis(hill_aug$D1, hill_aug$Site, do.exact = TRUE, do.asymp = TRUE)
kw_aug_D2 <- ANSM5::kruskal.wallis(hill_aug$D2, hill_aug$Site, do.exact = TRUE, do.asymp = TRUE)

kw_mar_D0 <- ANSM5::kruskal.wallis(hill_mar$D0, hill_mar$Site, do.exact = TRUE, do.asymp = TRUE)
kw_mar_D1 <- ANSM5::kruskal.wallis(hill_mar$D1, hill_mar$Site, do.exact = TRUE, do.asymp = TRUE)
kw_mar_D2 <- ANSM5::kruskal.wallis(hill_mar$D2, hill_mar$Site, do.exact = TRUE, do.asymp = TRUE)

# Exact pairwise Wilcoxon tests with Holm correction.
pw_aug_D1 <- pairwise.wilcox.test(
  hill_aug$D1, hill_aug$Site,
  p.adjust.method = "holm", exact = TRUE)

pw_mar_D0 <- pairwise.wilcox.test(
  hill_mar$D0, hill_mar$Site,
  p.adjust.method = "holm", exact = TRUE)

pw_mar_D1 <- pairwise.wilcox.test(
  hill_mar$D1, hill_mar$Site,
  p.adjust.method = "holm", exact = TRUE)

pw_mar_D2 <- pairwise.wilcox.test(
  hill_mar$D2, hill_mar$Site,
  p.adjust.method = "holm", exact = TRUE)

print(pw_aug_D1)
