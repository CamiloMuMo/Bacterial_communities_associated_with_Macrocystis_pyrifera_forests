get_core <- function(
    otu_matrix,
    metadata,
    variable,
    group,
    detection = 0.001,
    prevalence = 0.90) {

  ids <- metadata$SampleID[metadata[[variable]] == group]
  x <- otu_matrix[ids, , drop = FALSE]
  n_samples <- nrow(x)
  n_detected <- colSums(x >= detection)
  prev <- n_detected / n_samples

  data.frame(
    ASV = names(prev),
    n_samples = n_samples,
    n_detected = n_detected,
    prevalence = prev,
    core = prev >= prevalence,
    stringsAsFactors = FALSE)}

get_core_asvs <- function(variable, group, prevalence, detection = 0.001) {
  x <- get_core(core_mat, core_meta, variable, group, detection, prevalence)
  x$ASV[x$core]}

core_sensitivity <- function(
    variable,
    group,
    prevalence_values = c(0.80, 0.90, 1.00),
    detection = 0.001) {

  bind_rows(lapply(prevalence_values, function(p) {
    res <- get_core(core_mat, core_meta, variable, group, detection, p)
    data.frame(
      Variable = variable,
      Group = group,
      Detection = detection,
      Prevalence_threshold = p,
      n_samples = unique(res$n_samples),
      min_samples_required = ceiling(p * unique(res$n_samples)),
      n_core = sum(res$core))}))}

