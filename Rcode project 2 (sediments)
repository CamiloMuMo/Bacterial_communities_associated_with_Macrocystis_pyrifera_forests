# Helper to summarize phylum-level mean relative abundance by group. Phyla with
# mean abundance <5% are grouped as "Other" rather than removing and
# renormalizing them.
summarize_phyla <- function(ps, grouping_vars) {
  x <- ps %>%
    tax_glom(taxrank = "Phylum") %>%
    transform_sample_counts(function(z) z / sum(z)) %>%
    psmelt()

  x %>%
    group_by(across(all_of(c(grouping_vars, "Phylum")))) %>%
    summarise(Mean_RA = mean(Abundance), .groups = "drop") %>%
    group_by(across(all_of(grouping_vars))) %>%
    mutate(Phylum_plot = if_else(Mean_RA >= 0.05, as.character(Phylum), "Other")) %>%
    group_by(across(all_of(c(grouping_vars, "Phylum_plot")))) %>%
    summarise(Mean_RA = sum(Mean_RA), .groups = "drop")}

sed_phylum <- summarize_phyla(Sediments, c("Site", "Date"))
water_phylum <- summarize_phyla(Water, c("Site", "Date"))

