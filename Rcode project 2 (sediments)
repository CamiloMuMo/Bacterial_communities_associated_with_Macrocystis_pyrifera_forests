make_core_table <- function(variable, group, prevalence = 0.90, detection = 0.001) {
  res <- get_core(core_mat, core_meta, variable, group, detection, prevalence) %>%
    filter(core)

  ids <- core_meta$SampleID[core_meta[[variable]] == group]
  mean_ra <- colMeans(core_mat[ids, , drop = FALSE]) * 100

  res %>%
    transmute(
      Group = group,
      ASV,
      n_samples,
      n_detected,
      Prevalence = prevalence,
      Mean_RA_percent = mean_ra[ASV]
    ) %>%
    left_join(tax_core, by = "ASV")}

