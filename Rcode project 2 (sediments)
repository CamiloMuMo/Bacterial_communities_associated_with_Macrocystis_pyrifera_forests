# 3. RDA: sediment geochemistry and bacterial community composition--------

# Load sediment geochemical data
env_measured <- readxl::read_excel("data/Amb1.xlsx")

# Environmental variables used in the RDA
vars_rda <- c(
  "Organic Matter (%)",
  "Total N (%)",
  "Olsen P (mg/kg)")

# Check that all required columns are present
stopifnot(
  all(
    c("ID", "Site", "Type", "Date", vars_rda) %in%
      colnames(env_measured)))

# Check for duplicated sample IDs
stopifnot(!anyDuplicated(env_measured$ID))

# Keep sediment samples and variables used in the RDA
env_audit <- env_measured %>%
  filter(Type == "Sediment") %>%
  select(
    ID,
    Site,
    Type,
    Date,
    all_of(vars_rda))

# Check that all environmental sample IDs occur in the community matrix
stopifnot(all(env_audit$ID %in% rownames(otu_hell)))

# Count the number of observed environmental variables per sample
env_audit$n_observed <- rowSums(
  !is.na(env_audit[, vars_rda]))

# Check the number of sediment samples
stopifnot(nrow(env_audit) == 25)

# Inspect environmental-data completeness
table(env_audit$n_observed)

# Primary complete-case RDA: only samples with all three measured variables.
env_cc <- env_audit %>% filter(n_observed == 3)
stopifnot(nrow(env_cc) == 16)

ids_cc <- env_cc$ID
otu_rda_cc <- otu_hell[ids_cc, , drop = FALSE]
env_cc <- env_cc[match(rownames(otu_rda_cc), env_cc$ID), ]
stopifnot(identical(rownames(otu_rda_cc), env_cc$ID))

# Standardize the three measured geochemical variables to zero mean and unit variance
env_cc_scaled <- env_cc %>%
  select(`Organic Matter (%)`, `Total N (%)`, `Olsen P (mg/kg)`) %>%
  scale() %>%
  as.data.frame()

colnames(env_cc_scaled) <- c("Organic_Matter", "Total_N", "Olsen_P")
rownames(env_cc_scaled) <- env_cc$ID

# Primary RDA
rda_cc <- rda(
  otu_rda_cc ~ Organic_Matter + Total_N + Olsen_P,
