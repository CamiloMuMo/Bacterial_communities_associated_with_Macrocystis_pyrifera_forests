# Sensitivity analysis for missing environmental observations.
# Samples were eligible when at least two of the three variables were observed,
# so that a maximum of one missing value per sample was imputed.
env_imp <- env_audit %>%
  filter(n_observed >= 2) %>%
  mutate(
    OM_imputed = is.na(`Organic Matter (%)`),
    TotalN_imputed = is.na(`Total N (%)`),
    OlsenP_imputed = is.na(`Olsen P (mg/kg)`))

stopifnot(nrow(env_imp) == 20)

env_imp_matrix <- env_imp %>%
  select(all_of(vars_rda))

# Impute environmental variables only; Site, Date, and ASV abundances are not
# included as predictors.
set.seed(123)
mf_env <- missForest(
  env_imp_matrix,
  ntree = 500,
  maxiter = 10,
  variablewise = TRUE,
  verbose = FALSE)

print(mf_env$OOBerror)

env_imp_values <- mf_env$ximp

env_imp_final <- env_imp %>%
  select(
    ID, Site, Date, n_observed,
    OM_imputed, TotalN_imputed, OlsenP_imputed) %>%
  bind_cols(as.data.frame(env_imp_values))

# Display the four imputed observations.
print(
